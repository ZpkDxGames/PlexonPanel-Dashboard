# Public HTTPS origin of the database-less Cloudflare relay.
NEXT_PUBLIC_PLEXON_RELAY_URL=https://YOUR-RELAY.workers.dev

# Optional public, non-secret player-head template. Leave blank to disable remote heads.
# Production requires HTTPS and exactly one {uuid}; {size} is optional.
# Never place credentials, signed query strings, private origins, or reusable secrets here.
NEXT_PUBLIC_PLEXON_PLAYER_HEAD_URL_TEMPLATE=
