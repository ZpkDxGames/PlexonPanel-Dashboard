# Public HTTPS origin of the database-less Cloudflare relay.
NEXT_PUBLIC_PLEXON_RELAY_URL=https://YOUR-RELAY.workers.dev

# Optional public, non-secret player-head template override.
# Blank/unset uses the built-in MCHeads UUID provider:
#   https://mc-heads.net/avatar/{uuid}/{size}
# Set exactly "disabled" to disable remote player heads for the deployment.
# Custom production providers require HTTPS and exactly one {uuid}; {size} is optional.
# Never place credentials, signed query strings, private origins, or reusable secrets here.
NEXT_PUBLIC_PLEXON_PLAYER_HEAD_URL_TEMPLATE=
