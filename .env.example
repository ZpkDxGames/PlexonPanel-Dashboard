# Firebase Web App configuration (browser-visible by design)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Public production gateway URL (leave blank until the gateway exists)
NEXT_PUBLIC_PLEXON_GATEWAY_URL=

# Firebase Admin SDK (server-only; never prefix these with NEXT_PUBLIC_)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Gateway and session security (server-only)
PLEXON_GATEWAY_AUDIENCE=
PAIRING_CODE_PEPPER=
SESSION_COOKIE_SECRET=
