{
  "name": "plexonpanel-dashboard",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "relay:build": "tsc -p relay/tsconfig.json",
    "relay:keygen": "node relay/scripts/generate-secrets.mjs",
    "relay:dev": "npx wrangler@latest dev --config relay/wrangler.jsonc",
    "relay:deploy": "npx wrangler@latest deploy --config relay/wrangler.jsonc",
    "relay:test": "npm run relay:build && node --test relay/tests/*.test.mjs",
    "env:vercel": "node scripts/create-vercel-env.mjs",
    "test": "node scripts/transpile-tests.mjs && node scripts/build-test.mjs && node --test --test-concurrency=1 tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern node_modules",
    "check": "npm run lint && npm run typecheck && npm run relay:test && npm test",
    "typecheck": "tsc --noEmit && npm run relay:build"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "wrangler": "4.129.0"
  },
  "type": "module",
  "displayName": "PlexonPanel Dashboard"
}
