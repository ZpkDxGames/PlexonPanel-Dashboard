{
  "name": "plexonpanel-dashboard",
  "version": "1.0.0-rc.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "gateway:build": "tsc -p gateway/tsconfig.json",
    "gateway:keygen": "node gateway/scripts/generate-identity.mjs",
    "gateway:start": "node gateway/dist/index.js",
    "gateway:test": "npm run gateway:build && node --test gateway/tests/*.test.mjs",
    "env:vercel": "node scripts/create-vercel-env.mjs",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern node_modules",
    "check": "npm run lint && npm run gateway:test && npm test"
  },
  "dependencies": {
    "firebase-admin": "^14.2.0",
    "next": "16.3.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "PlexonPanel Dashboard"
}
