{
  "name": "plexonpanel-command-center",
  "private": true,
  "version": "6.5.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "build": "tsc --noEmit && vite build && node scripts/identity.mjs",
    "check": "tsc --noEmit && node --import tsx --test tests/*.test.ts",
    "test:browser": "node scripts/browser-check.mjs",
    "test:perf": "node scripts/performance.mjs",
    "test:revamp": "node scripts/revamp-interactions.mjs",
    "test:visual": "node scripts/revamp-capture.mjs --axe",
    "test:refinement": "node scripts/refine-browser.mjs",
    "test:release65": "node scripts/release65-browser.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "motion": "14.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fake-indexeddb": "6.2.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
