# PlexonPanel standalone relay — copy to /etc/plexonpanel-relay/relay.env
# Never commit the populated production file.
PLEXON_RELAY_HOST=127.0.0.1
PLEXON_RELAY_PORT=8787
PLEXON_RELAY_DATABASE_PATH=/var/lib/plexonpanel-relay/relay.db

# Exact browser origins only. Comma-separated; wildcard origins are rejected.
PLEXON_RELAY_DASHBOARD_ORIGINS=https://plexon-panel-dashboard.vercel.app

# Reuse the current Worker secrets only if you possess them securely.
# Otherwise generate/rotate intentionally and re-pair as documented.
PAIRING_CODE_PEPPER=<64-or-more-random-characters>
ACCESS_TOKEN_SECRET=<64-or-more-random-characters>
GATEWAY_ED25519_PRIVATE_KEY=<PKCS8-BASE64>
GATEWAY_ED25519_PUBLIC_KEY=<SPKI-BASE64>

# Public browser traffic is expected to arrive only from local cloudflared.
PLEXON_RELAY_TRUSTED_PROXY=cloudflare-loopback
PLEXON_RELAY_DASHBOARD_LIMIT=12
PLEXON_RELAY_UNAUTHENTICATED_LIMIT=8
PLEXON_RELAY_HANDSHAKE_TIMEOUT_MS=15000
PLEXON_RELAY_GRACEFUL_SHUTDOWN_MS=10000

# Deliberately omitted in production: PLEXON_RELAY_ALLOW_PUBLIC_BIND.
